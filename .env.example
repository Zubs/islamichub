# Copy this file to .env. See "Environment" in README.md.
# Server only. Read by the hadith proxy (netlify/functions/hadith.js); run `netlify dev` to use it locally.
HADITH_API_KEY=
VITE_STATS_ENDPOINT=
# Web Push. Make a pair with `node scripts/make-vapid-keys.js`. The public key is read by the site
# and the server; the private key and the contact address by the server only.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
